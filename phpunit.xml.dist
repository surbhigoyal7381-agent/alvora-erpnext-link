<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="server/tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="unit">
            <file>./server/tests/OutboundGuardTest.php</file>
            <file>./server/tests/OutboundGuardVectorsTest.php</file>
            <file>./server/tests/PackageShapeTest.php</file>
        </testsuite>
        <testsuite name="integration">
            <directory suffix="Test.php">./server/tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./server/src</directory>
        </include>
    </source>
</phpunit>
