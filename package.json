{
    "name": "@alvora/erpnext-link-engine",
    "version": "0.1.0",
    "description": "Connect a client organization to its ERPNext site from the AlvoraVector admin console",
    "keywords": [
        "fleetbase-extension",
        "fleetbase",
        "ember-addon",
        "ember-engine",
        "erpnext"
    ],
    "fleetbase": {
        "route": "erpnext-link"
    },
    "repository": "https://github.com/surbhigoyal7381-agent/alvora-erpnext-link",
    "license": "AGPL-3.0-or-later",
    "author": "Alvora",
    "directories": {
        "app": "app",
        "addon": "addon",
        "tests": "tests"
    },
    "scripts": {
        "build": "ember build --environment=production",
        "lint": "concurrently \"npm:lint:*(!fix)\" --names \"lint:\"",
        "lint:hbs": "ember-template-lint .",
        "lint:hbs:fix": "ember-template-lint . --fix",
        "lint:intl": "fleetbase-intl-lint --path ./addon --translation-path ./translations/en-us.yaml",
        "lint:js": "eslint . --cache",
        "lint:js:fix": "eslint . --fix",
        "lint:privacy": "node scripts/check-no-secrets.js",
        "start": "ember serve",
        "test": "concurrently \"npm:lint\" \"npm:test:*\" --names \"lint,test:\"",
        "test:ember": "EMBER_ENGINE_EAGER=1 ember test"
    },
    "dependencies": {
        "@babel/core": "^7.23.2",
        "@fleetbase/ember-core": "^0.3.26",
        "ember-auto-import": "^2.7.4",
        "ember-cli-babel": "^8.2.0",
        "ember-cli-htmlbars": "^6.3.0",
        "ember-concurrency": "^4.0.4",
        "ember-intl": "6.3.2"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.22.15",
        "@babel/plugin-proposal-decorators": "^7.23.2",
        "@ember/legacy-built-in-components": "^0.4.2",
        "@ember/optional-features": "^2.0.0",
        "@ember/string": "^3.1.1",
        "@ember/test-helpers": "^3.2.0",
        "@embroider/test-setup": "^3.0.2",
        "@fleetbase/intl-lint": "^0.0.1",
        "@glimmer/component": "^1.1.2",
        "@glimmer/tracking": "^1.1.2",
        "broccoli-asset-rev": "^3.0.0",
        "concurrently": "^8.2.2",
        "ember-cli": "~5.4.1",
        "ember-cli-dependency-checker": "^3.3.2",
        "ember-cli-inject-live-reload": "^2.1.0",
        "ember-cli-sri": "^2.1.1",
        "ember-cli-terser": "^4.0.2",
        "ember-composable-helpers": "^5.0.0",
        "ember-data": "^4.12.5",
        "ember-engines": "^0.9.0",
        "ember-load-initializers": "^2.1.2",
        "ember-page-title": "^8.0.0",
        "ember-qunit": "^8.0.1",
        "ember-resolver": "^11.0.1",
        "ember-source": "~5.4.0",
        "ember-template-lint": "^5.11.2",
        "eslint": "^8.52.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-ember": "^11.11.1",
        "eslint-plugin-n": "^16.2.0",
        "eslint-plugin-prettier": "^5.0.1",
        "eslint-plugin-qunit": "^8.0.1",
        "loader.js": "^4.7.0",
        "prettier": "^3.0.3",
        "qunit": "^2.20.0",
        "qunit-dom": "^2.0.0",
        "webpack": "^5.89.0"
    },
    "peerDependencies": {
        "ember-engines": "^0.9.0"
    },
    "engines": {
        "node": ">= 18"
    },
    "ember": {
        "edition": "octane"
    },
    "ember-addon": {
        "configPath": "tests/dummy/config"
    },
    "prettier": {
        "trailingComma": "es5",
        "tabWidth": 4,
        "semi": true,
        "singleQuote": true,
        "printWidth": 190,
        "overrides": [
            {
                "files": "*.hbs",
                "options": {
                    "singleQuote": false
                }
            }
        ]
    }
}
