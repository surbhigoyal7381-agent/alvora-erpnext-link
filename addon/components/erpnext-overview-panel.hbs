<section class="rounded-md border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800" data-test-erpnext-panel>
    <div class="flex items-center justify-between gap-4">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">{{t "alvora-erpnext-link.panel.title"}}</h2>
        {{#if this.status}}
            <span class="rounded-full border px-3 py-1 text-xs font-medium {{this.badgeClass}}" data-test-panel-badge>
                <span aria-hidden="true">{{this.badgeGlyph}}</span>
                {{t (concat "alvora-erpnext-link.badge." this.state)}}
            </span>
        {{/if}}
    </div>
    {{#if this.failed}}
        <p class="mt-3 text-sm text-gray-700 dark:text-gray-200" role="alert" data-test-panel-failed>{{t "alvora-erpnext-link.panel.failed"}}</p>
        <button type="button" class="mt-2 rounded border border-gray-300 px-3 py-1 text-xs dark:border-gray-600" {{on "click" this.retry}}>{{t "alvora-erpnext-link.retry"}}</button>
    {{else if this.status}}
        {{#if this.isDisconnected}}
            <p class="mt-3 text-sm text-gray-700 dark:text-gray-200">{{t "alvora-erpnext-link.panel.not-set-up"}}</p>
        {{else if this.isConnecting}}
            <p class="mt-3 text-sm text-gray-700 dark:text-gray-200">{{t "alvora-erpnext-link.panel.connecting"}}</p>
        {{/if}}
        {{#unless this.isDisconnected}}
            <dl class="mt-3 divide-y divide-gray-200 text-sm dark:divide-gray-700">
                <div class="flex justify-between gap-4 py-2"><dt class="text-gray-600 dark:text-gray-300">{{t "alvora-erpnext-link.rows.site"}}</dt><dd class="text-gray-900 dark:text-white">{{this.host}}</dd></div>
                {{#if this.isConnecting}}
                    <div class="flex justify-between gap-4 py-2"><dt class="text-gray-600 dark:text-gray-300">{{t "alvora-erpnext-link.panel.progress-label"}}</dt><dd class="text-gray-900 dark:text-white">{{this.progress}}</dd></div>
                {{else if this.isConnected}}
                    <div class="flex justify-between gap-4 py-2"><dt class="text-gray-600 dark:text-gray-300">{{t "alvora-erpnext-link.rows.last-test"}}</dt><dd class="text-gray-900 dark:text-white">{{this.lastTest}}</dd></div>
                {{else}}
                    <div class="flex justify-between gap-4 py-2"><dt class="text-gray-600 dark:text-gray-300">{{t "alvora-erpnext-link.panel.happened"}}</dt><dd class="text-gray-900 dark:text-white">{{this.happened}}</dd></div>
                    <div class="flex justify-between gap-4 py-2"><dt class="text-gray-600 dark:text-gray-300">{{t "alvora-erpnext-link.rows.last-attempt"}}</dt><dd class="text-gray-900 dark:text-white">{{this.lastAttempt}}</dd></div>
                {{/if}}
            </dl>
        {{/unless}}
        <a href={{this.tabUrl}} class="mt-3 inline-block text-sm text-blue-700 underline dark:text-blue-400" data-test-panel-link {{on "click" this.openTab}}>{{t this.linkKey}}</a>
    {{else}}
        <p class="mt-3 text-sm text-gray-700 dark:text-gray-200" data-test-panel-loading>{{t "alvora-erpnext-link.panel.loading"}}</p>
    {{/if}}
</section>
